PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ML_SERVICE_BASE_URL=http://127.0.0.1:8001
SMART_AGENT_ML_SERVICE_BASE_URL=http://127.0.0.1:8002
DEMAND_FORECASTING_SERVICE_URL=http://127.0.0.1:8004
ANOMALY_DETECTION_SERVICE_URL=http://127.0.0.1:8005
ROUTING_SERVICE_BASE_URL=https://router.project-osrm.org
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
# Set a different, independently generated random secret for agent sessions.
AGENT_JWT_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
AGENT_JWT_EXPIRES_IN=1d
DELIVERY_TRACKING_TTL_DAYS=7
# Local development only. Production requires S3-compatible object storage.
POD_STORAGE_PROVIDER=local
POD_STORAGE_DIR=./private_uploads/pod
# Production S3 configuration:
# POD_STORAGE_PROVIDER=s3
# POD_S3_BUCKET=your-private-pod-bucket
# POD_S3_REGION=auto
# For Cloudflare R2, use https://<account-id>.r2.cloudflarestorage.com
# POD_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# POD_S3_FORCE_PATH_STYLE=true
# Cloudflare R2 requires both AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# AWS_SESSION_TOKEN is optional when using temporary credentials.
# Only returns a development test OTP; it never sends a customer message. Keep false outside local testing.
POD_DEV_OTP_ENABLED=false
